generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  manager
  csr
  readonly
}

enum OpportunityType {
  missed_call
  estimate_rescue
  reactivation
}

enum OpportunityStatus {
  open
  contacted
  responded
  booked
  lost
  archived
}

enum CallDirection {
  inbound
  outbound
}

enum CallDisposition {
  missed
  after_hours
  abandoned
  responded
  booked
  lost
}

enum EstimateStatus {
  draft
  sent
  stale
  enrolled_followup
  responded
  booked
  lost
}

enum CampaignStatus {
  draft
  active
  paused
  completed
}

enum CampaignChannel {
  sms
  email
}

enum TemplateType {
  sms
  email
}

enum MessageDirection {
  outbound
  inbound
}

enum MessageStatus {
  queued
  sent
  delivered
  failed
  received
}

enum IntegrationProvider {
  twilio
  jobber
  housecall_pro
  servicetitan
  gmail
  outlook
  google_calendar
  csv_import
}

enum IntegrationStatus {
  connected
  disconnected
  error
}

enum BookingSource {
  manual
  missed_call
  estimate_rescue
  reactivation
}

enum ActivityType {
  call_missed
  opportunity_created
  opportunity_updated
  note_added
  message_sent
  message_received
  booking_created
  campaign_launched
  estimate_enrolled
  integration_updated
  settings_updated
}

model Business {
  id                                   String                  @id @default(cuid())
  name                                 String
  timezone                             String                  @default("America/Detroit")
  staleEstimateDays                    Int                     @default(7)
  attributionWindowDays                Int                     @default(14)
  highValueThreshold                   Int                     @default(2500)
  duplicateMissedCallSuppressionHours  Int                     @default(4)
  createdAt                            DateTime                @default(now())
  updatedAt                            DateTime                @updatedAt
  users                                User[]
  locations                            Location[]
  contacts                             Contact[]
  opportunities                        Opportunity[]
  callEvents                           CallEvent[]
  estimates                            Estimate[]
  campaigns                            Campaign[]
  templates                            Template[]
  messageEvents                        MessageEvent[]
  bookings                             Booking[]
  activityLogs                         ActivityLog[]
  integrationConnections               IntegrationConnection[]
  reportSnapshots                      ReportSnapshot[]
}

model User {
  id                    String            @id @default(cuid())
  businessId            String
  email                 String            @unique
  name                  String
  role                  UserRole          @default(csr)
  passwordHash          String
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  business              Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  opportunitiesOwned    Opportunity[]     @relation("OpportunityOwner")
  notes                 OpportunityNote[] @relation("NoteAuthor")
  createdCampaigns      Campaign[]        @relation("CampaignCreator")
  createdTemplates      Template[]        @relation("TemplateCreator")
  activityLogs          ActivityLog[]

  @@index([businessId])
}

model Location {
  id         String     @id @default(cuid())
  businessId String
  name       String
  phone      String?
  address1   String?
  city       String?
  state      String?
  postalCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contacts   Contact[]
  callEvents CallEvent[]
  estimates  Estimate[]

  @@index([businessId])
}

model Contact {
  id                    String         @id @default(cuid())
  businessId            String
  locationId            String?
  firstName             String
  lastName              String
  phone                 String
  email                 String?
  tags                  String[]       @default([])
  notes                 String?
  lastServiceDate       DateTime?
  nextServiceDue        DateTime?
  membershipRenewalDate DateTime?
  systemInstallDate     DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  business              Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location              Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  opportunities         Opportunity[]
  callEvents            CallEvent[]
  estimates             Estimate[]
  messageEvents         MessageEvent[]
  bookings              Booking[]
  activityLogs          ActivityLog[]

  @@index([businessId])
  @@index([phone])
}

model Opportunity {
  id               String            @id @default(cuid())
  businessId       String
  contactId        String
  assignedUserId   String?
  campaignId       String?
  type             OpportunityType
  status           OpportunityStatus @default(open)
  title            String
  description      String?
  sourceRef        String?
  potentialValue   Decimal           @db.Decimal(12, 2)
  influencedValue  Decimal           @default(0) @db.Decimal(12, 2)
  recoveredValue   Decimal           @default(0) @db.Decimal(12, 2)
  openedAt         DateTime          @default(now())
  lastActivityAt   DateTime          @default(now())
  closedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser     User?             @relation("OpportunityOwner", fields: [assignedUserId], references: [id], onDelete: SetNull)
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  notes            OpportunityNote[]
  callEvents       CallEvent[]
  estimate         Estimate?
  messageEvents    MessageEvent[]
  bookings         Booking[]
  activityLogs     ActivityLog[]

  @@index([businessId, type, status])
  @@index([contactId])
  @@index([assignedUserId])
}

model OpportunityNote {
  id            String      @id @default(cuid())
  opportunityId String
  userId        String?
  content       String
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User?       @relation("NoteAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
}

model CallEvent {
  id            String          @id @default(cuid())
  businessId    String
  contactId     String?
  locationId    String?
  opportunityId String?
  fromNumber    String
  toNumber      String
  direction     CallDirection   @default(inbound)
  disposition   CallDisposition @default(missed)
  durationSec   Int?
  source        String          @default("twilio_mock")
  externalId    String?
  occurredAt    DateTime        @default(now())
  respondedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact       Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  location      Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  opportunity   Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  booking       Booking?

  @@index([businessId, disposition, occurredAt])
  @@index([contactId])
  @@index([opportunityId])
}

model Estimate {
  id            String         @id @default(cuid())
  businessId    String
  contactId     String
  locationId    String?
  opportunityId String?        @unique
  estimateNo    String
  serviceType   String
  amount        Decimal        @db.Decimal(12, 2)
  status        EstimateStatus @default(sent)
  sentAt        DateTime
  staleAt       DateTime
  enrolledAt    DateTime?
  respondedAt   DateTime?
  bookedAt      DateTime?
  lostAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact       Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  location      Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  booking       Booking?

  @@index([businessId, status, staleAt])
  @@index([contactId])
}

model Campaign {
  id               String          @id @default(cuid())
  businessId       String
  createdByUserId  String?
  name             String
  segment          String
  status           CampaignStatus  @default(draft)
  launchCount      Int             @default(0)
  launchedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy        User?           @relation("CampaignCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  steps            CampaignStep[]
  opportunities    Opportunity[]
  messageEvents    MessageEvent[]
  bookings         Booking[]
  activityLogs     ActivityLog[]

  @@index([businessId, status])
}

model CampaignStep {
  id           String          @id @default(cuid())
  campaignId   String
  stepOrder    Int
  channel      CampaignChannel
  delayHours   Int             @default(0)
  templateId   String?
  bodyOverride String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template     Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([campaignId, stepOrder])
}

model Template {
  id              String         @id @default(cuid())
  businessId      String
  createdByUserId String?
  name            String
  type            TemplateType
  subject         String?
  content         String
  variables       String[]       @default([])
  isArchived      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy       User?          @relation("TemplateCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  steps           CampaignStep[]
  messageEvents   MessageEvent[]

  @@index([businessId, type, isArchived])
}

model MessageEvent {
  id                 String           @id @default(cuid())
  businessId         String
  contactId          String?
  opportunityId      String?
  campaignId         String?
  templateId         String?
  direction          MessageDirection
  status             MessageStatus
  channel            String           @default("sms")
  providerExternalId String?
  body               String
  sentAt             DateTime?
  receivedAt         DateTime?
  createdAt          DateTime         @default(now())
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact            Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity        Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  campaign           Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  template           Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([contactId])
  @@index([opportunityId])
}

model Booking {
  id            String        @id @default(cuid())
  businessId    String
  contactId     String
  opportunityId String?
  callEventId   String?       @unique
  estimateId    String?       @unique
  campaignId    String?
  source        BookingSource
  revenue       Decimal       @db.Decimal(12, 2)
  scheduledAt   DateTime
  createdAt     DateTime      @default(now())
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  callEvent     CallEvent?    @relation(fields: [callEventId], references: [id], onDelete: SetNull)
  estimate      Estimate?     @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  campaign      Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([businessId, scheduledAt])
}

model ActivityLog {
  id            String       @id @default(cuid())
  businessId    String
  userId        String?
  contactId     String?
  opportunityId String?
  campaignId    String?
  action        ActivityType
  message       String
  details       Json?
  isAlert       Boolean      @default(false)
  alertLevel    String?
  createdAt     DateTime     @default(now())
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  campaign      Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([isAlert, createdAt])
}

model IntegrationConnection {
  id                String              @id @default(cuid())
  businessId        String
  provider          IntegrationProvider
  status            IntegrationStatus   @default(disconnected)
  externalAccountId String?
  connectedAt       DateTime?
  lastTestedAt      DateTime?
  lastError         String?
  config            Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
}

model ReportSnapshot {
  id                       String    @id @default(cuid())
  businessId               String
  snapshotDate             DateTime
  recoveredRevenue         Decimal   @db.Decimal(12, 2)
  influencedRevenue        Decimal   @db.Decimal(12, 2)
  opportunitiesRecovered   Int
  bookingsCreated          Int
  avgResponseMinutes       Int
  estimatesReopened        Int
  customersReactivated     Int
  workflowComparison       Json
  createdAt                DateTime  @default(now())
  business                 Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, snapshotDate])
}
