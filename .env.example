# Database
DATABASE_URL="postgresql://user:password@localhost:5432/revenueleak?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-secret"

# Twilio (optional — app runs in mock mode without these)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Demo mode — set to "true" to bypass auth and seed demo data
DEMO_MODE="true"
